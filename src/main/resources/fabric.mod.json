{
  "schemaVersion": 1,
  "id": "cameramod",
  "version": "${version}",
  "name": "Virtual Camera",
  "description": "A Camera entity's POV right into a virtual webcam",
  "authors": ["TGdoesCode"],
  "contact": {
    "homepage": "https://modrinth.com/mod/virtualcamera",
    "sources": "https://github.com/tggamesyt/cameramod",
    "issues": "https://tggamesyt.dev/discord?flashz",
    "discord": "https://tggamesyt.dev/discord?flashz"
  },
  "license": "GNU GENERAL PUBLIC LICENSE",
  "--accessWidener": "cameramod.accesswidener",
  "icon": "assets/cameramod/textures/item/camera_item.png",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "dev.tggamesyt.cameramod.client.CameramodDataGenerator"
    ],
    "client": [
      "dev.tggamesyt.cameramod.client.CameramodClient"
    ],
    "main": [
      "dev.tggamesyt.cameramod.Cameramod"
    ]
  },
  "mixins": [
    "cameramod.mixins.json",
    {
      "config": "cameramod.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric": "*",
    "minecraft": "${minecraft_version}"
  }
}
